# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Alpaca paper trading (https://app.alpaca.markets)
ALPACA_API_KEY=
ALPACA_API_SECRET=
STREAM_SYMBOLS=["SPY","AAPL","MSFT","BTC/USD","ETH/USD"]

# Optional. How many more symbols the charts may stream at once; Alpaca's free plan allows 30 in all.
WATCH_LIMIT=20

# Optional. The stock data feed for the stream, the chart and the price check on market buys: iex (the
# free Basic plan, 30 streamed symbols) or sip (all exchanges; needs Algo Trader Plus, or Alpaca refuses it).
# Orders fill the same whichever feed is chosen. The scanner's daily history is always SIP.
# DATA_FEED=iex

# Optional. Guards for market orders on coins, read from the order book; 0 turns one off.
# MAX_SPREAD_MULTIPLE: refuse a market order when the spread is more than this many times the coin's usual one.
# MAX_SLIPPAGE_BPS: refuse one that would pay more than this over the mid, in basis points, walking the book.
# SLICE_SLIPPAGE_BPS: keep each market slice of a TWAP or VWAP of a coin under this cost past the best price.
# MAX_SPREAD_MULTIPLE=3
# MAX_SLIPPAGE_BPS=100
# SLICE_SLIPPAGE_BPS=20
# MAX_BOOK_IMBALANCE: refuse a market order on a coin when its best ten levels lean this far against it and the last minute's flow agrees (0 switches it off).
# MAX_BOOK_IMBALANCE=0.6

# Limits on every buy placed by hand or through the API (the autopilot is governed by its allocation and books).
# MAX_POSITION_SHARE: the most one position may be, as a share of account value.
# DAILY_LOSS_LIMIT: no new buys once the account is down this much today.
# MAX_ADV_SHARE: the most a stock buy may be of the stock's average daily dollar volume.
# MAX_STOCK_SPREAD_BPS: the widest quoted spread a market buy of a stock may cross.
# MAX_POSITION_SHARE=0.25
# DAILY_LOSS_LIMIT=0.03
# MAX_ADV_SHARE=0.01
# MAX_STOCK_SPREAD_BPS=50

# Optional. Drift monitor: watches the daily returns of every strategy and agent. A change counts
# when the last 60 days sit DRIFT_THRESHOLD baseline deviations away (Wasserstein) and a KS test puts
# p under DRIFT_SIGNIFICANCE. With DRIFT_ACTION=act an adverse change cuts the strategy's sizing to
# DRIFT_SCALE for DRIFT_HOLD_DAYS days and asks for a retrain; log only records it; off checks nothing.
# DRIFT_ACTION=act
# DRIFT_THRESHOLD=0.1
# DRIFT_SIGNIFICANCE=0.001
# DRIFT_SCALE=0.5
# DRIFT_HOLD_DAYS=30
# DRIFT_BASELINE_DAYS=500

# Optional. Train PPO, SAC and A2C each month and follow what they would hold; nothing is traded.
# The first run gives each agent a three-year record and takes about 50 minutes. Needs uv run poe finrl-setup.
# AI_AGENTS=false

# Optional. The SEC asks automated clients to name a real contact, for example "Your Name you@example.com".
# Without it the scanner skips SEC filings and works from news alone.
SEC_CONTACT=

# Optional. Email alerts: an SMTP server (STARTTLS on 587, TLS on 465) and the addresses. Without them,
# alerts go in the terminal and to the webhook set in Settings only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=

# Optional. The coins the scanner compares, as a JSON list of codes against USD. These ten are established
# coins with a year of history; the list is a convenience and not a Shariah ruling. The scanner never trades them.
# CRYPTO_COINS=["BTC","ETH","SOL","XRP","LINK","AVAX","DOT","LTC","BCH","UNI"]

# The trading node and the API share one Postgres: `platform` holds the API's tables and the
# order commands, `node` holds the state only the trading node writes.
DATABASE_URL=postgresql+psycopg://algotr:change-me@localhost:5432/algotr
# Which Alpaca account the trading node is allowed to trade; it refuses to start if the keys
# belong to the other kind. Changing it needs a restart, never a runtime switch.
ALPACA_TRADING_MODE=paper

# The trading node's safe default is NODE_MODE=validate: it loads the factory and logs what it
# would run, but never connects to a venue or trades. Set NODE_MODE=live to run it.
NODE_MODE=validate
# The `module:callable` that builds the node, as the Helm chart's live.factory names it.
NODE_FACTORY=trading_node.factory:build

# Optional. On start the API fetches FinBERT and Kronos in the background when they are missing (about 540 MB;
# FinBERT's weights are non-commercial). false leaves it to `uv run poe setup`.
# AUTO_FETCH_MODELS=true

# Optional. Browser origins allowed to call the API directly, as a JSON list. Not needed behind the terminal's
# nginx or the dev server, which share its origin.
# CORS_ORIGINS=["https://terminal.example.com"]

# Optional. Docker builds install the CPU build of torch from this index (about 4 GB image). If the build cannot reach
# it (a network that intercepts TLS), use https://pypi.org/simple, which pulls the much larger CUDA build.
# TORCH_INDEX=https://download.pytorch.org/whl/cpu
