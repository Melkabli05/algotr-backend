{
  "title": "algotr",
  "uid": "algotr-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Circuit breakers (0 closed, 1 half-open, 2 open)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "algotr_breaker_state",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "title": "Kill switches engaged",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "algotr_kill_switch_engaged",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "title": "Strategy stage",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "algotr_strategy_stage == 1",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "title": "Strategy Sharpe, 30 and 90 days",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "algotr_strategy_sharpe",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "title": "Drift statistic per stream",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "algotr_drift_score",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "title": "Alerts per minute by kind",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (kind, tier) (rate(algotr_alerts_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "title": "Order rejections per hour",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(algotr_order_rejections_total[1h]) * 3600",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "title": "Seconds since the node's heartbeat",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "time() - algotr_node_heartbeat_seconds",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "title": "Node order events per minute",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(algotr_node_order_events_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "title": "Arbiter runs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (sent) (increase(algotr_arbiter_runs_total[1d]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "title": "API latency p95 (s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 12,
      "title": "API requests per second by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}
